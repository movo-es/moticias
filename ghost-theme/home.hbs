{{!< default}}
{{!-- Portada de edición: todo se resuelve en el servidor con {{#get}} para que buscadores y motores generativos lean la portada entera. --}}
<section class="edition-head">
  <div class="wrap">
    {{#get "pages" filter="slug:edicion-hoy" limit="1" fields="title,custom_excerpt,meta_description,updated_at"}}
      {{#foreach pages}}
      <div class="edition-line">
        <h1 class="edition-title">{{title}}</h1>
        <p class="edition-stamp"><span>{{custom_excerpt}}</span><span>Actualizado {{date updated_at format="HH:mm"}} CET</span></p>
      </div>
      <p class="answer">{{meta_description}}</p>
      {{/foreach}}
    {{else}}
      <h1 class="edition-title">MOTICIAS</h1>
      <p class="answer">{{@site.description}}</p>
    {{/get}}
  </div>
</section>

<section class="cover">
  <div class="wrap">
    <div class="cover-grid">
      {{#get "posts" filter="featured:true" limit="1" include="tags,authors"}}
        {{#foreach posts}}
        <article class="lead {{primary_tag.slug}}">
          <div class="photo">{{#if feature_image}}<img srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1600w" sizes="(max-width: 860px) 100vw, 60vw" src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">{{else}}<span class="art art-{{primary_tag.slug}}"></span>{{/if}}</div>
          <div class="shade"></div>
          {{#if feature_image_caption}}<span class="credit">{{{feature_image_caption}}}</span>{{/if}}
          <div class="text">
            <div class="kicker">Apertura · {{primary_tag.name}}</div>
            <h2><a href="{{url}}">{{title}}</a></h2>
            {{#if custom_excerpt}}<p class="dek">{{custom_excerpt}}</p>{{/if}}
            {{> "meta" show_author=true}}
          </div>
        </article>
        {{/foreach}}
      {{/get}}
      <div class="rail">
        {{#get "posts" filter="tag:analisis" limit="1" include="tags,authors"}}
          {{#foreach posts}}
          <article class="analysis-card">
            <div class="kicker analisis">Análisis del día</div>
            <h3><a href="{{url}}">{{title}}</a></h3>
            {{#if custom_excerpt}}<p class="dek">{{custom_excerpt}}</p>{{/if}}
            <div class="byline"><span class="avatar">{{#primary_author}}{{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{else}}R{{/if}}{{/primary_author}}</span><span><b>{{primary_author.name}}</b><br>Director de MOTICIAS · {{reading_time minute="1 min" minutes="% min"}} de lectura</span></div>
            <p class="drop">{{meta_description}}</p>
            <a class="readmore" href="{{url}}">Leer el análisis completo →</a>
          </article>
          {{/foreach}}
        {{/get}}
        {{#get "posts" filter="tag:hash-segunda" limit="1" include="tags,authors"}}
          {{#foreach posts}}
          <article class="second {{primary_tag.slug}}">
            {{> "thumb"}}
            <div class="body">
              <div class="kicker {{primary_tag.slug}}">Segunda · {{primary_tag.name}}</div>
              <h3><a href="{{url}}">{{title}}</a></h3>
              {{#if custom_excerpt}}<p class="dek">{{custom_excerpt}}</p>{{/if}}
              {{> "meta"}}
            </div>
          </article>
          {{/foreach}}
        {{/get}}
        <div class="brief">
          <h4>En cinco titulares</h4>
          <ol>
          {{#get "posts" filter="featured:false+tag:-hash-segunda+tag:-analisis" limit="5" include="tags"}}
            {{#foreach posts}}<li><div><a href="{{url}}">{{title}}</a><div class="meta"><span class="kicker {{primary_tag.slug}}">{{primary_tag.name}}</span><time class="num">{{date published_at format="D MMM"}}</time></div></div></li>{{/foreach}}
          {{/get}}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="block essentials">
  <div class="wrap">
    {{> "section-head" sec="" title="Lo esencial" sub="por modo de transporte, regulación y contratos"}}
    <div class="ess-grid">
      <div class="ess-col tierra"><h3 class="ess-h"><a href="/tierra/">Tierra</a></h3>
        {{#get "posts" filter="primary_tag:tierra+featured:false+tag:-hash-segunda+tag:-hash-reportaje" limit="3" include="tags"}}<ul class="list">{{#foreach posts}}{{> "lista"}}{{/foreach}}</ul>{{/get}}</div>
      <div class="ess-col mar"><h3 class="ess-h"><a href="/mar/">Mar</a></h3>
        {{#get "posts" filter="primary_tag:mar+featured:false+tag:-hash-segunda+tag:-hash-reportaje" limit="3" include="tags"}}<ul class="list">{{#foreach posts}}{{> "lista"}}{{/foreach}}</ul>{{/get}}</div>
      <div class="ess-col aire"><h3 class="ess-h"><a href="/aire/">Aire</a></h3>
        {{#get "posts" filter="primary_tag:aire+featured:false+tag:-hash-segunda+tag:-hash-reportaje" limit="3" include="tags"}}<ul class="list">{{#foreach posts}}{{> "lista"}}{{/foreach}}</ul>{{/get}}</div>
      <div class="ess-col regulacion"><h3 class="ess-h"><a href="/regulacion/">Regulación</a></h3>
        {{#get "posts" filter="primary_tag:regulacion+featured:false+tag:-hash-segunda+tag:-hash-reportaje" limit="3" include="tags"}}<ul class="list">{{#foreach posts}}{{> "lista"}}{{/foreach}}</ul>{{/get}}</div>
      <div class="ess-col licitaciones"><h3 class="ess-h"><a href="/licitaciones/">Licitaciones</a></h3>
        {{#get "posts" filter="primary_tag:licitaciones+featured:false+tag:-hash-segunda+tag:-hash-reportaje" limit="3" include="tags"}}<ul class="list">{{#foreach posts}}{{> "lista"}}{{/foreach}}</ul>{{/get}}</div>
    </div>
  </div>
</section>

<section class="block ad-block"><div class="wrap">{{> "promo" slot="portada-medio"}}</div></section>

{{#get "posts" filter="tag:hash-reportaje" limit="3" include="tags,authors"}}{{#if posts}}
<section class="block">
  <div class="wrap">
    {{> "section-head" sec="analisis" title="Reportajes" sub="investigación propia: el sistema, el dinero y la regla" url="/analisis/"}}
    <div class="features">{{#foreach posts}}{{> "feature"}}{{/foreach}}</div>
  </div>
</section>
{{/if}}{{/get}}

{{#get "pages" filter="slug:edicion-hoy" limit="1" formats="html"}}
  {{#foreach pages}}
  <section class="block edition-page">
    <div class="wrap">{{content}}</div>
  </section>
  {{/foreach}}
{{/get}}

<section class="block ad-block"><div class="wrap">{{> "promo" slot="portada-pie"}}</div></section>

<section class="block">
  <div class="wrap">
    {{#get "pages" filter="slug:como-trabajamos" fields="url" limit="1"}}{{#if pages}}{{#foreach pages}}{{> "section-head" sec="" title="Cómo trabajamos" sub="método, firmas y correcciones" url=url}}{{/foreach}}{{else}}{{> "section-head" sec="" title="Cómo trabajamos" sub="método, firmas y correcciones"}}{{/if}}{{/get}}
    <div class="method">
      <div><h3>Fuentes primarias</h3><p>Ninguna pieza se publica sin al menos una fuente primaria enlazada —BOE, DOUE, ministerios, reguladores, gestores—, con su fecha de publicación y la de consulta. La prensa sectorial ayuda a encontrar; nunca es fuente única.</p></div>
      <div><h3>Firmas e IA bajo supervisión</h3><p>Usamos inteligencia artificial para barrer boletines y preparar borradores, bajo reglas editoriales escritas. Las piezas rutinarias firma G. Jordan, redactor responsable; los análisis y las piezas críticas, el director, que las aprueba antes de publicarlas. Los errores se corrigen con nota fechada.</p></div>
    </div>
  </div>
</section>
