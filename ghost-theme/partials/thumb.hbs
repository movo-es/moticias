<div class="thumb">{{#if feature_image}}<img srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w" sizes="(max-width: 560px) 100vw, 400px" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">{{else}}<span class="art art-{{primary_tag.slug}}" aria-hidden="true"></span>{{/if}}</div>
