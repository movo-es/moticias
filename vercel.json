{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "framework": null,
 "outputDirectory": "app/public",
 "functions": {
  "api/gestor.py": {
   "includeFiles": "{src,verticals,data,portal/data,portal/img}/**",
   "maxDuration": 300
  },
  "api/prensa.py": {
   "includeFiles": "{src,verticals,data/notas-de-prensa,data/articles}/**",
   "maxDuration": 120
  },
  "api/agenda.py": {
   "includeFiles": "{src/**,verticals/**,data/eventos/**,portal/spain.js}",
   "maxDuration": 60
  }
 },
 "headers": [
  {
   "source": "/gestor/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    }
   ]
  },
  {
   "source": "/buscador/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "https://www.moticias.com"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=600, stale-while-revalidate=3600"
    }
   ]
  },
  {
   "source": "/sitio/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=300, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/prensa/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/",
   "destination": "/gestor/",
   "permanent": false
  }
 ],
 "crons": [
  {
   "path": "/api/gestor?a=comprobar",
   "schedule": "23 8-19 * * *"
  },
  {
   "path": "/api/gestor?a=prensa_cron",
   "schedule": "45 14 * * 3"
  },
  {
   "path": "/api/gestor?a=ghost_al_dia",
   "schedule": "*/15 6-19 * * *"
  },
  {
   "path": "/api/gestor?a=aplicar_buzon",
   "schedule": "*/10 * * * *"
  },
  {
   "path": "/api/gestor?a=copias_vigilar",
   "schedule": "5 8 * * *"
  },
  {
   "path": "/api/gestor?a=seo_bateria",
   "schedule": "10 6-9 * * 0"
  }
 ],
 "rewrites": [
  {
   "source": "/feed/agenda.ics",
   "destination": "/api/agenda?a=ics"
  }
 ]
}
