{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "framework": null,
 "outputDirectory": "app/public",
 "functions": {
  "api/gestor.py": {
   "includeFiles": "{src,verticals,data/articles,data/productos,data/ads,data/retoques}/**",
   "maxDuration": 30
  },
  "api/prensa.py": {
   "includeFiles": "{src,verticals,data/medios,data/articles}/**",
   "maxDuration": 120
  }
 },
 "headers": [
  {
   "source": "/gestor/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    }
   ]
  },
  {
   "source": "/buscador/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "https://www.moticias.com"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=600, stale-while-revalidate=3600"
    }
   ]
  },
  {
   "source": "/prensa/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/",
   "destination": "/gestor/",
   "permanent": false
  }
 ]
}
